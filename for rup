<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Rup ❤️</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        body {
            background: linear-gradient(135deg, #ff4d6d 0%, #ff758f 25%, #ffb3c1 50%, #ffc8d3 100%);
            font-family: 'Poppins', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            min-height: 100vh;
        }

        /* Animated background elements */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: 1;
            animation: shimmer 15s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        .container {
            width: 90%;
            max-width: 700px;
            position: relative;
            z-index: 10;
            height: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            perspective: 1000px;
        }

        .card {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 30px;
            padding: 50px 40px;
            color: white;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15), 
                        inset 0 1px 1px rgba(255, 255, 255, 0.3);
            opacity: 0;
            transform: translateY(30px) scale(0.95);
            pointer-events: none;
            transition: opacity 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                        transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-height: 70vh;
            overflow-y: auto;
        }

        .card.active {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }

        /* Scrollbar styling */
        .card::-webkit-scrollbar {
            width: 6px;
        }

        .card::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        .card::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

        .card::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }

        /* Titles */
        h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 5vw, 3.5rem);
            font-weight: 800;
            margin-bottom: 25px;
            line-height: 1.2;
            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            letter-spacing: -0.5px;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 4vw, 2.8rem);
            font-weight: 700;
            margin-bottom: 25px;
            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        /* Paragraphs */
        p {
            font-size: clamp(1rem, 2.5vw, 1.15rem);
            line-height: 1.85;
            margin-bottom: 20px;
            font-weight: 300;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        /* Typewriter animation */
        .typewriter {
            overflow: hidden;
            white-space: normal;
            display: inline-block;
            letter-spacing: 0.05em;
            font-size: 1.15rem;
            font-weight: 400;
            line-height: 1.6;
        }

        .typewriter::after {
            content: '';
            animation: cursor-blink 0.7s infinite;
        }

        @keyframes cursor-blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0; }
        }

        /* Buttons */
        .btn {
            padding: 16px 40px;
            border: none;
            border-radius: 50px;
            background: white;
            color: #ff4d6d;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            margin-top: 20px;
            font-family: 'Poppins', sans-serif;
            letter-spacing: 0.5px;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 77, 109, 0.1);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
            background: #ffe5ec;
        }

        .btn:active::before {
            width: 300px;
            height: 300px;
        }

        /* Memory Grid */
        .memory-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 30px 0;
            width: 100%;
        }

        .memory-card {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 25px 15px;
            border-radius: 20px;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            animation: slideUp 0.6s ease forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        .memory-card:nth-child(1) { animation-delay: 0.1s; }
        .memory-card:nth-child(2) { animation-delay: 0.2s; }
        .memory-card:nth-child(3) { animation-delay: 0.3s; }
        .memory-card:nth-child(4) { animation-delay: 0.4s; }

        .memory-card:hover {
            transform: translateY(-8px) scale(1.05);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            background: rgba(255, 255, 255, 0.18);
            border-color: rgba(255, 255, 255, 0.35);
        }

        .memory-emoji {
            font-size: 2rem;
            margin-bottom: 10px;
            display: block;
        }

        /* Countdown/Final message */
        .highlight {
            font-size: 1.4rem;
            font-weight: 700;
            margin: 25px 0;
            color: rgba(255, 255, 255, 1);
            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            animation: glow 2s ease-in-out infinite;
        }

        @keyframes glow {
            0%, 100% {
                text-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            }
            50% {
                text-shadow: 0 4px 25px rgba(255, 255, 255, 0.3);
            }
        }

        /* Floating hearts */
        .floating-heart {
            position: fixed;
            color: rgba(255, 255, 255, 0.7);
            font-size: 2rem;
            pointer-events: none;
            z-index: 5;
            animation: float 6s linear forwards;
        }

        @keyframes float {
            0% {
                transform: translateY(0) translateX(0) scale(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) translateX(100px) scale(1);
                opacity: 0;
            }
        }

        /* Sparkles */
        .sparkle {
            position: fixed;
            font-size: 1.5rem;
            pointer-events: none;
            z-index: 5;
            animation: sparkle-burst 0.8s ease-out forwards;
        }

        @keyframes sparkle-burst {
            0% {
                opacity: 1;
                transform: scale(0) translate(0, 0);
            }
            100% {
                opacity: 0;
                transform: scale(1) translate(var(--tx), var(--ty));
            }
        }

        /* Modal for final message */
        .modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.8);
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 50px 40px;
            border-radius: 30px;
            text-align: center;
            color: white;
            width: 90%;
            max-width: 550px;
            z-index: 1000;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            opacity: 0;
            pointer-events: none;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal.active {
            opacity: 1;
            pointer-events: all;
            transform: translate(-50%, -50%) scale(1);
        }

        .modal h1 {
            margin-bottom: 20px;
        }

        .modal p {
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .modal h2 {
            margin-top: 30px;
            margin-bottom: 0;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .card {
                padding: 35px 25px;
                border-radius: 25px;
            }

            h1 {
                font-size: 2.2rem;
            }

            h2 {
                font-size: 1.8rem;
            }

            p {
                font-size: 1rem;
            }

            .memory-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .container {
                min-height: 60vh;
            }

            .modal {
                padding: 35px 25px;
                width: 95%;
            }

            .btn {
                padding: 14px 35px;
                font-size: 0.95rem;
            }
        }

        @media (max-width: 480px) {
            .card {
                padding: 30px 20px;
                border-radius: 20px;
            }

            h1 {
                font-size: 1.8rem;
            }

            h2 {
                font-size: 1.5rem;
            }

            p {
                font-size: 0.95rem;
            }

            .memory-grid {
                grid-template-columns: 1fr;
            }

            .memory-card {
                padding: 20px 15px;
                font-size: 0.9rem;
            }

            .highlight {
                font-size: 1.2rem;
            }

            .btn {
                padding: 12px 30px;
                font-size: 0.9rem;
                width: 100%;
            }

            .container {
                min-height: 50vh;
            }

            .modal {
                padding: 30px 20px;
                width: 92%;
            }
        }

        /* Smooth scroll behavior */
        html {
            scroll-behavior: smooth;
        }

        /* Loading animation */
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Pulse animation for special text */
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Step 1: Introduction -->
        <div class="card active" id="step1">
            <h1>Happy Birthday<br>Rup ❤️</h1>
            
            <p class="typewriter">Today is all about the most special girl in my life...</p>
            
            <button class="btn" onclick="nextStep(1, 2)">
                Open Your Gift 🎁
            </button>
        </div>

        <!-- Step 2: Love Message -->
        <div class="card" id="step2">
            <h2>For My Favorite<br>Person 💖</h2>
            
            <p>
                Thank you for making every moment beautiful.<br><br>
                Your smile makes my worst days better.<br><br>
                Your presence brings peace to my soul.<br><br>
                I never want to lose you.
            </p>
            
            <button class="btn" onclick="nextStep(2, 3)">
                Continue ❤️
            </button>
        </div>

        <!-- Step 3: Memories -->
        <div class="card" id="step3">
            <h2>Our Beautiful<br>Memories ✨</h2>
            
            <div class="memory-grid">
                <div class="memory-card">
                    <span class="memory-emoji">🌸</span>
                    First Conversation
                </div>
                <div class="memory-card">
                    <span class="memory-emoji">😊</span>
                    First Smile
                </div>
                <div class="memory-card">
                    <span class="memory-emoji">💕</span>
                    Endless Calls
                </div>
                <div class="memory-card">
                    <span class="memory-emoji">🌙</span>
                    Late Night Talks
                </div>
            </div>
            
            <p style="margin-top: 30px; font-style: italic;">
                Every moment with you is a precious memory I cherish forever.
            </p>
            
            <button class="btn" onclick="nextStep(3, 4)">
                One Last Surprise 🎊
            </button>
        </div>

        <!-- Step 4: Final Declaration -->
        <div class="card" id="step4">
            <h1>I Love You<br>Rup 💞</h1>
            
            <p>
                You are my favorite person in this world.<br><br>
                No matter what happens, I will always care for you.<br><br>
                You are my rock, my comfort, and my greatest joy.
            </p>
            
            <div class="highlight">
                Together Through Every Moment 💕
            </div>
            
            <p>
                You are not only my love,<br>
                you are my peace,<br>
                my happiness,<br>
                and my favorite chapter of life.
            </p>
            
            <button class="btn" onclick="showFinalMessage()">
                Forever With You 💍
            </button>
        </div>
    </div>

    <!-- Final Message Modal -->
    <div class="modal" id="finalModal">
        <h1>My Forever Person ❤️</h1>
        
        <p>
            No matter where life takes us,<br>
            I just want you beside me.<br><br>
            You are my peace,<br>
            my happiness,<br>
            and the best thing that ever happened to me.
        </p>
        
        <h2>Happy Birthday Rup 💖</h2>
        
        <p style="margin-top: 25px; font-size: 0.95rem; opacity: 0.9;">
            I love you more than words can express.
        </p>
    </div>

    <script>
        // ============================================
        // Navigation Functions
        // ============================================

        function nextStep(currentStep, nextStep) {
            const currentCard = document.getElementById(`step${currentStep}`);
            const nextCard = document.getElementById(`step${nextStep}`);
            
            currentCard.classList.remove('active');
            
            setTimeout(() => {
                nextCard.classList.add('active');
            }, 50);
            
            triggerFireworks();
        }

        function showFinalMessage() {
            const modal = document.getElementById('finalModal');
            modal.classList.add('active');
            triggerFireworks();
            createIntenseHearts();
        }

        // ============================================
        // Particle Effects
        // ============================================

        function triggerFireworks() {
            const burstCount = 40;
            for (let i = 0; i < burstCount; i++) {
                createSparkle();
            }
        }

        function createSparkle() {
            const sparkle = document.createElement('div');
            sparkle.classList.add('sparkle');
            sparkle.textContent = '✨';
            
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;
            
            sparkle.style.left = centerX + 'px';
            sparkle.style.top = centerY + 'px';
            
            // Random direction
            const angle = Math.random() * Math.PI * 2;
            const distance = 50 + Math.random() * 200;
            const tx = Math.cos(angle) * distance;
            const ty = Math.sin(angle) * distance;
            
            sparkle.style.setProperty('--tx', tx + 'px');
            sparkle.style.setProperty('--ty', ty + 'px');
            
            document.body.appendChild(sparkle);
            
            setTimeout(() => sparkle.remove(), 800);
        }

        function createFloatingHeart() {
            const heart = document.createElement('div');
            heart.classList.add('floating-heart');
            heart.textContent = '❤️';
            
            const startX = Math.random() * window.innerWidth;
            const duration = Math.random() * 3 + 3;
            const horizontalDrift = (Math.random() - 0.5) * 200;
            
            heart.style.left = startX + 'px';
            heart.style.bottom = '-50px';
            heart.style.animationDuration = duration + 's';
            heart.style.setProperty('--drift', horizontalDrift + 'px');
            
            document.body.appendChild(heart);
            
            setTimeout(() => heart.remove(), duration * 1000);
        }

        function createIntenseHearts() {
            for (let i = 0; i < 8; i++) {
                setTimeout(() => createFloatingHeart(), i * 100);
            }
        }

        // Continuous heart generation
        setInterval(createFloatingHeart, 400);

        // ============================================
        // Typewriter Animation
        // ============================================

        function initTypewriter() {
            const typewriterElement = document.querySelector('.typewriter');
            const text = typewriterElement.textContent;
            typewriterElement.textContent = '';
            
            let charIndex = 0;
            const speed = 50;

            function type() {
                if (charIndex < text.length) {
                    typewriterElement.textContent += text.charAt(charIndex);
                    charIndex++;
                    setTimeout(type, speed);
                }
            }

            type();
        }

        // Initialize on page load
        window.addEventListener('load', initTypewriter);

        // ============================================
        // Enhanced Mobile Support
        // ============================================

        if (window.innerWidth <= 768) {
            document.body.style.minHeight = '100vh';
        }

        // Prevent scrolling on body for better UX
        document.body.style.overflow = 'hidden';

        // ============================================
        // Preload Fonts
        // ============================================

        if (document.fonts) {
            document.fonts.ready.then(() => {
                console.log('Fonts loaded');
            });
        }
    </script>
</body>

</html>
